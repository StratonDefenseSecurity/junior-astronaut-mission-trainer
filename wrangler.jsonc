// Despliegue en Cloudflare Workers. Ver README, sección "Despliegue".
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "mision-marte-trainer",
  "account_id": "e205fb741a6d9827ec596ebd9adfa1da",
  "main": "server/cloudflare.ts",
  "compatibility_date": "2026-09-01",
  // El servidor usa node:crypto, node:async_hooks y Buffer.
  "compatibility_flags": ["nodejs_compat"],
  // El sitio compilado. Los archivos se sirven sin pasar por el Worker; solo /api/* lo ejecuta.
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  // Un Durable Object por sala y otro para las cuentas (ver server/cloudflare.ts).
  "durable_objects": {
    "bindings": [{ "name": "MISION", "class_name": "Mision" }]
  },
  // v2 borró todos los datos anteriores (salas, ranking y cuentas) el 14/11/2026 para empezar de cero.
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["Nodo"] },
    { "tag": "v2", "deleted_classes": ["Nodo"] },
    { "tag": "v3", "new_sqlite_classes": ["Mision"] }
  ],
  "observability": { "enabled": true }
}
