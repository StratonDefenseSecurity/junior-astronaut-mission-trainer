{
  "name": "mission-trainer",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k \"npm:dev:server\" \"npm:dev:client\"",
    "dev:client": "vite",
    "dev:server": "tsx watch server/index.ts",
    "build": "vite build",
    "start": "cross-env NODE_ENV=production tsx server/index.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.server.json && tsc --noEmit -p tsconfig.worker.json",
    "simular": "tsx scripts/simular.ts",
    "e2e": "node scripts/e2e.mjs",
    "desplegar": "vite build && wrangler deploy",
    "cf:dev": "vite build && wrangler dev",
    "empaquetar:vercel": "node scripts/empaquetar.mjs",
    "desplegar:vercel": "node scripts/desplegar.mjs",
    "ui": "node scripts/ui.mjs"
  },
  "dependencies": {
    "@react-three/drei": "^9.114.0",
    "@react-three/fiber": "^8.17.10",
    "@vercel/blob": "^2.8.1",
    "astronomy-engine": "^2.1.19",
    "express": "^4.21.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "three": "^0.169.0",
    "topojson-client": "^3.1.0",
    "world-atlas": "^2.0.2",
    "zustand": "^5.0.1"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261014.1",
    "@types/express": "^4.17.21",
    "@types/node": "^22.9.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@types/three": "^0.169.0",
    "@types/topojson-client": "^3.1.5",
    "@vitejs/plugin-react": "^4.3.3",
    "concurrently": "^9.1.0",
    "cross-env": "^7.0.3",
    "d3-celestial": "^0.7.35",
    "esbuild": "^0.28.2",
    "geotiff": "^2.1.3",
    "puppeteer-core": "^23.11.1",
    "sharp": "^0.35.5",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "vite": "^5.4.11",
    "wrangler": "^4.150.0"
  }
}
